# MaxLab Frontend Development Environment
# OAuth Server 재구조화 대응 (maxplatform/oauth-server/)

# OAuth 2.0 Settings - Development (로컬 개발용)
VITE_AUTH_SERVER_URL=https://max.dwchem.co.kr
VITE_MAX_PLATFORM_URL=https://max.dwchem.co.kr
VITE_CLIENT_ID=maxlab
VITE_REDIRECT_URI=http://localhost:3010/oauth/callback

# OAuth Endpoints - 새 OAuth Server 구조 (/auth/* 경로)
VITE_OAUTH_AUTHORIZE_URL=https://max.dwchem.co.kr/auth/authorize
VITE_OAUTH_TOKEN_URL=https://max.dwchem.co.kr/auth/token
VITE_OAUTH_USERINFO_URL=https://max.dwchem.co.kr/auth/userinfo
VITE_OAUTH_LOGOUT_URL=https://max.dwchem.co.kr/auth/logout

# Backend API URL (Development)
VITE_API_BASE_URL=http://localhost:8010
VITE_AUTH_API_URL=https://max.dwchem.co.kr

# Development Server Settings
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3010

# Environment
VITE_NODE_ENV=development

# Feature flags for development
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_DEBUG_LOGS=true

# 개발자 노트:
# - OAuth Server가 maxplatform/oauth-server/ 위치로 재구조화됨
# - 모든 OAuth 엔드포인트가 /auth/* 경로로 변경됨
# - PKCE (Proof Key for Code Exchange) 지원 활성화됨
# - 로컬 개발 시 localhost:3010 포트 사용
# - Production OAuth Server (max.dwchem.co.kr)와 연동